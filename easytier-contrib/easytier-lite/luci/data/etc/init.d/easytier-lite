#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME=easytier-lite
BIN=/usr/bin/easytier-lite

append_peer() {
	ARGS="$ARGS -p $1"
}

append_proxy() {
	ARGS="$ARGS -n $1"
}

append_group() {
	ARGS="$ARGS --private-group $1"
}

start_service() {
	local enabled
	config_load "$NAME"
	config_get_bool enabled config enabled 0
	[ "$enabled" = "1" ] || return 0

	local network_name network_secret hostname ipv4 dhcp listen_port no_listener tun log_level
	config_get network_name config network_name ""
	config_get network_secret config network_secret ""
	config_get hostname config hostname ""
	config_get ipv4 config ipv4 ""
	config_get_bool dhcp config dhcp 0
	config_get listen_port config listen_port "11010"
	config_get_bool no_listener config no_listener 0
	config_get_bool tun config tun 0
	config_get log_level config log_level "info"

	[ -n "$network_name" ] || {
		echo "easytier-lite: network_name is not configured, not starting" >&2
		return 1
	}

	# NOTE: values must not contain spaces (same restriction as the CLI)
	ARGS="--network-name $network_name"
	[ -n "$network_secret" ] && ARGS="$ARGS --network-secret $network_secret"
	[ -n "$hostname" ] && ARGS="$ARGS --hostname $hostname"

	if [ "$dhcp" = "1" ]; then
		ARGS="$ARGS -d"
	elif [ -n "$ipv4" ]; then
		ARGS="$ARGS --ipv4 $ipv4"
	fi

	config_list_foreach config peers append_peer

	if [ "$no_listener" = "1" ]; then
		ARGS="$ARGS --no-listener"
	else
		ARGS="$ARGS -l tcp://0.0.0.0:$listen_port,udp://0.0.0.0:$listen_port"
	fi

	[ "$tun" = "1" ] && ARGS="$ARGS --tun"

	config_list_foreach config proxy_networks append_proxy
	config_list_foreach config private_groups append_group

	[ "$log_level" != "info" ] && ARGS="$ARGS --console-log-level $log_level"

	procd_open_instance
	procd_set_param command $BIN $ARGS
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
